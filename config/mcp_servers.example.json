{
  "mcpServers": {
    "filesystem": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:/Users/me/projects"
      ],
      "enabled": true,
      "permission": "ask"
    },
    "browser": {
      "transport": "sse",
      "url": "http://localhost:8931/sse",
      "enabled": false,
      "permission": "ask"
    }
  }
}
